/* ─── Main Layout ───────────────────────────────────────────────── */

#main-layout {
    width: 100%;
    height: 1fr;
}

/* ─── Note List ─────────────────────────────────────────────────── */

NoteListView {
    width: 100%;
    height: 1fr;
    padding: 0;
    margin: 0;
    background: $surface-darken-1;
}

NoteListView > NoteItem {
    padding: 0;
    margin: 0;
    background: $surface;
}

.note-item-layout {
    height: auto;
    align: left middle;
    padding: 1 2;
}

.note-uid {
    width: 10;
    color: $text-disabled;
    margin-right: 1;
}

.note-id {
    width: 4;
    color: $accent;
    text-align: left;
    margin-right: 1;
    text-style: bold;
}

.note-content-container {
    width: 1fr;
    height: auto;
}

.note-content {
    width: 1fr;
    color: $text;
}

.note-ref {
    color: $secondary;
    text-style: italic;
    margin-top: 1;
}

.note-time {
    width: 14;
    color: $text-disabled;
    text-align: right;
    margin-left: 1;
}

NoteListView > NoteItem.selected {
    background: $surface-lighten-1;
}

NoteListView > NoteItem.--highlighted {
    background: $surface-lighten-1;
}

/* ─── Bottom Preview ──────────────────────────────────────── */

#bottom-preview {
    width: 100%;
    height: 15;
    padding: 1 2;
    background: $surface-darken-1;
    color: $text-muted;
    display: none;
}

/* ─── Inputs ────────────────────────────────────────────────────── */

#search-input,
#add-input {
    dock: bottom;
    margin: 0;
    border: none;
    background: $surface-darken-1;
    padding: 0 2;
}

/* ─── Footer ────────────────────────────────────────────────────── */

#footer {
    dock: bottom;
    background: $surface-darken-2;
    color: $text-muted;
    padding: 0 2;
    height: 1;
}

/* ─── Full-Screen View ──────────────────────────────────────────── */

#view-container {
    width: 100%;
    height: 100%;
    background: $surface;
}

#view-scroll-area {
    width: 100%;
    height: 1fr;
}

#view-header {
    background: $surface-lighten-1;
    color: $text;
    padding: 1 2;
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#view-context {
    padding: 0 2 2 2;
    color: $text;
    height: auto;
    width: 100%;
}
